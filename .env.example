# Copy to .env.local and fill in. None of these are required to run the site —
# without RESEND_API_KEY the contact form falls back to opening the visitor's
# mail client, so the form is never a dead end.

# https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address. Must be on a domain you have verified with Resend.
# Defaults to Resend's shared sandbox sender, which only delivers to your own
# Resend account address.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Where contact form messages are delivered. Defaults to profile.email.
CONTACT_TO=
